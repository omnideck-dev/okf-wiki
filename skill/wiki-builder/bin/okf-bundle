#!/usr/bin/env python3
"""okf-bundle — Create or initialize an OKF v0.2 knowledge bundle."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# Ensure our library is importable
sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))

from okf.bundle import Bundle, OKF_VERSION
from okf.registry import Registry


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Create or initialize an OKF v0.2 knowledge bundle"
    )
    parser.add_argument("path", type=Path, help="Path to the bundle directory")
    parser.add_argument(
        "--project", "-p", type=str, default=None,
        help="Project name (default: directory name)"
    )
    parser.add_argument(
        "--force", "-f", action="store_true",
        help="Overwrite existing bundle structure"
    )
    args = parser.parse_args()

    root = args.path.resolve()
    project = args.project or root.name

    if root.exists() and not args.force:
        # Check if it looks like a bundle already
        existing_md = list(root.rglob("*.md"))
        if existing_md and not args.force:
            print(f"Bundle already exists at {root} ({len(existing_md)} .md files)")
            print(f"Use --force to reinitialize")
            sys.exit(1)
    elif not root.exists():
        root.mkdir(parents=True, exist_ok=True)

    # Create standard subdirectories
    for subdir in ["sources", "concepts", "references"]:
        (root / subdir).mkdir(parents=True, exist_ok=True)
        # Create empty index for each
        idx = root / subdir / "index.md"
        label = subdir.title()
        idx.write_text(f"# {label}\n\n_Empty directory._\n", encoding="utf-8")

    # Create root index.md
    root_index = root / "index.md"
    root_index.write_text(
        "---\n"
        f'okf_version: "{OKF_VERSION}"\n'
        "---\n"
        f"\n# {project} — Knowledge Bundle\n\n"
        f"_Auto-generated by okf-bundle._\n\n"
        "## Sources\n"
        f"* [Source concepts](sources/) — imported source files\n\n"
        "## Concepts\n"
        f"* [Extracted concepts](concepts/) — higher-level knowledge\n\n"
        "## References\n"
        f"* [Reference material](references/) — external references\n",
    )

    # Create log.md
    log_path = root / "log.md"
    from datetime import datetime, timezone
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    log_path.write_text(
        f"# {project} Update Log\n\n"
        f"## {today}\n"
        f"* **Creation**: Initialized OKF v{OKF_VERSION} bundle at {root}\n",
    )

    # Register with the bundle registry
    reg = Registry.load()
    reg.register(str(root), project)
    reg.save()

    print(f"OKF v{OKF_VERSION} bundle created at {root}")
    print(f"  Project: {project}")
    print(f"  Subdirectories: sources/, concepts/, references/")
    print(f"  Files: index.md, log.md")


if __name__ == "__main__":
    main()