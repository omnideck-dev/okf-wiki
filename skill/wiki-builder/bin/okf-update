#!/usr/bin/env python3
"""okf-update — Full update pipeline: scan → import → index.

This is the primary entry point for updating a wiki. It:
1. Scans the source tree for changed files (mtime or git)
2. Imports them as OKF concepts
3. Generates/updates index.md files
4. Writes log.md entries
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))

from okf.bundle import Bundle
from okf.source import SourceTree, scan_changed_files
from okf.importer import import_all
from okf.indexer import generate_index, generate_log_entry
from okf.registry import Registry


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Update an OKF knowledge bundle from source files"
    )
    parser.add_argument(
        "source", type=Path,
        help="Source directory, repo, or file collection"
    )
    parser.add_argument(
        "--bundle", "-b", type=Path, default=None,
        help="Bundle directory (default: ~/wiki/<project_name>)"
    )
    parser.add_argument(
        "--name", "-n", type=str, default=None,
        help="Project name (default: source directory name)"
    )
    parser.add_argument(
        "--match", action="store_true",
        help="Auto-select bundle by matching project name in registry"
    )
    parser.add_argument(
        "--subdir", "-s", type=str, default="sources",
        help="Bundle subdirectory for imported files (default: sources)"
    )
    parser.add_argument(
        "--all", "-a", action="store_true",
        help="Re-import all files (ignore change detection)"
    )
    parser.add_argument(
        "--method", choices=["auto", "mtime", "git"], default="auto",
        help="Change detection method (default: auto)"
    )
    parser.add_argument(
        "--force", "-f", action="store_true",
        help="Overwrite existing concept files"
    )
    parser.add_argument(
        "--concepts", action="store_true",
        help="Also run concept extraction (LLM-assisted, generates"
             " higher-level concepts from imported source concepts)"
    )
    args = parser.parse_args()

    source_root = args.source.resolve()
    if not source_root.exists():
        print(f"Error: source path {source_root} does not exist")
        sys.exit(1)

    project_name = args.name or source_root.name

    # Determine bundle path
    if args.bundle:
        bundle_root = args.bundle.resolve()
    elif args.match:
        reg = Registry.load()
        matches = reg.find_all(project_name)
        if len(matches) == 0:
            # No match — proceed as normal (create new)
            bundle_root = Path.home() / "wiki" / project_name
            print(f"No matching bundle found. Will create new bundle at {bundle_root}")
        elif len(matches) == 1:
            bundle_root = Path(matches[0].path)
            project_name = matches[0].project  # Preserve the bundle's original project name
            print(f"Found matching bundle: {project_name} at {bundle_root}")
        else:
            print(f"Multiple bundles match '{project_name}':")
            for i, m in enumerate(matches, 1):
                print(f"  {i}. {m.project} — {m.path}")
            print("Use --bundle to specify which one, or --name to narrow the match.")
            sys.exit(2)
    else:
        bundle_root = Path.home() / "wiki" / project_name

    # Open or create bundle
    bundle = Bundle.open_or_create(bundle_root)

    # Auto-initialize if this is a new bundle
    root_index = bundle.root / "index.md"
    if not root_index.exists():
        from okf.bundle import OKF_VERSION
        from datetime import datetime, timezone
        bundle.ensure_dir("sources")
        bundle.ensure_dir("concepts")
        bundle.ensure_dir("references")
        today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        root_index.write_text(
            "---\n" f'okf_version: "{OKF_VERSION}"\n' "---\n"
            f"\n# {project_name} — Knowledge Bundle\n\n"
            f"_Auto-generated by okf-update._\n\n"
            "## Sources\n"
            f"* [Source concepts](sources/) — imported source files\n\n"
            "## Concepts\n"
            f"* [Extracted concepts](concepts/) — higher-level knowledge\n\n"
            "## References\n"
            f"* [Reference material](references/) — external references\n",
        )
        (bundle.root / "log.md").write_text(
            f"# {project_name} Update Log\n\n"
            f"## {today}\n"
            f"* **Creation**: Initialized OKF v{OKF_VERSION} bundle\n",
        )
        print(f"Created new OKF bundle at {bundle_root}")

    print(f"OKF Bundle: {bundle_root}")
    print(f"Source:     {source_root}")

    # Set up source tree and detect changes
    source = SourceTree.from_path(source_root, name=project_name)
    source.walk()

    if args.all:
        changed_files = source.files
        deleted_paths: list[str] = []
        print(f"Mode:       full re-import ({len(changed_files)} files)")
    else:
        last_commit = None
        if args.method == "git" or (args.method == "auto" and source.is_git_repo):
            last_commit = source.find_last_commit()

        changed_files, deleted_paths = scan_changed_files(
            source,
            bundle.manifest.data,
            method=args.method,
            last_commit=last_commit,
        )
        print(f"Mode:       incremental ({len(changed_files)} changed, "
              f"{len(deleted_paths)} deleted)")

    if not changed_files and not deleted_paths:
        print(f"No changes detected. Bundle is current with "
              f"{len(bundle.manifest.data)} tracked files.")
        bundle.save_manifest()

        # Still update indexes in case concepts were manually edited
        indices = generate_index(bundle, subdir=args.subdir)
        if indices:
            print(f"Updated {len(indices)} index.md file(s)")

        # Register/update bundle in registry
        reg = Registry.load()
        reg.register(str(bundle_root), project_name)
        reg.save()
        return

    # Import changed files
    print(f"\nImporting files...")
    created, updated = import_all(changed_files, bundle, source, subdir=args.subdir)

    # Handle deletions
    deleted_concepts: list[str] = []
    for del_path in deleted_paths:
        prev = bundle.manifest.data.get(str(Path(del_path).resolve()))
        if prev:
            concept = Path(prev.get("concept_path", ""))
            if concept and concept.exists() and args.force:
                concept.unlink()
                try:
                    deleted_concepts.append(str(concept.relative_to(bundle.root)))
                except ValueError:
                    pass
            bundle.manifest.remove(Path(del_path))

    # Save manifest
    bundle.save_manifest()

    # Regenerate indexes
    print(f"Generating indexes...")
    indices = generate_index(bundle, subdir=args.subdir)

    # Write log entry
    created_rel = []
    updated_rel = []
    for fi in changed_files[:created] if created > 0 else []:
        created_rel.append(f"{args.subdir}/{fi.rel_path}")
    for fi in changed_files[created:] if updated > 0 else []:
        updated_rel.append(f"{args.subdir}/{fi.rel_path}")

    generate_log_entry(
        bundle,
        "Update",
        f"Imported {created + updated} file(s) from {project_name} "
        f"({created} new, {updated} updated, {len(deleted_concepts)} removed)",
        created=created_rel,
        updated=updated_rel,
        deleted=deleted_concepts,
    )

    # Register/update bundle in registry
    reg = Registry.load()
    reg.register(str(bundle_root), project_name)
    reg.save()

    # Summary
    print(f"\n{'='*50}")
    print(f"Update complete!")
    print(f"  Bundle:     {bundle_root}")
    print(f"  Created:    {created} concept(s)")
    print(f"  Updated:    {updated} concept(s)")
    print(f"  Removed:    {len(deleted_concepts)} concept(s)")
    print(f"  Indexes:    {len(indices)} file(s)")
    print(f"  Manifest:   {len(bundle.manifest.data)} file(s) tracked")
    print(f"{'='*50}")
    print(f"Quick commands:")
    print(f"  Validate:    okf-validate {bundle_root}")
    print(f"  Browse:      ls {bundle_root}/sources/")
    print(f"  Re-index:    okf-index {bundle_root}")


if __name__ == "__main__":
    main()